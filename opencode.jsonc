{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["docs/architecture.md", "docs/conventions.md", "docs/security.md"],
  "formatter": true,
  "lsp": true,
  "compaction": {
    "auto": true,
    "prune": true,
  },
  "agent": {
    "review": {
      "description": "Read-only reviewer for diffs, branch changes, and PRs. Cannot edit or write files.",
      "mode": "subagent",
      "tools": {
        "edit": false,
        "write": false,
      },
    },
  },
}
