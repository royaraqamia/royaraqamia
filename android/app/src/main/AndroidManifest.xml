<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Deep links. The shell serves the live site, so a link to our own
              origin should open the app rather than a browser tab: autoVerify
              makes Android confirm us against
              https://royaraqamia.com/.well-known/assetlinks.json, which lists
              both the release and the debug signing certificate.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="royaraqamia.com" />
            </intent-filter>

            <!--
              The OAuth return trip. Google refuses its consent screen in an
              embedded WebView, so sign-in leaves for the system browser and
              comes back on this scheme; MainActivity maps it onto the https
              callback so the code is exchanged inside the WebView's own cookie
              jar. Keep in sync with NATIVE_OAUTH_CALLBACK_URL in
              shared/contracts/auth.ts and the Supabase redirect allowlist.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="royar" android:host="auth" />
            </intent-filter>

        </activity>

        <!--
          FCM needs a channel on Android 8+; this is the one the system falls
          back to when a push does not name its own.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="default" />

        <!--
          The shell's FCM receiver (ADR-0059, ADR-0060). Firebase delivers
          MESSAGING_EVENT to exactly one service, so the plugin's is removed
          rather than left beside ours, and `SyncMessagingService` delegates the
          plugin's own two jobs (a message's data for the page, a rotated token)
          back to it. Leaving both declared would be a coin toss over which one
          receives a push — including the visible ones the notification bell
          depends on.
        -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />
        <service
            android:name=".SyncMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      The Scanner (ADR-0035) calls `getUserMedia`, and the WebView asks the app
      for the camera — Capacitor turns `VIDEO_CAPTURE` into this permission and
      launches Android's own request (`BridgeWebChromeClient.onPermissionRequest`).
      Undeclared, the request is refused before any dialog is drawn, Chrome
      rejects `getUserMedia` with `NotAllowedError`, and the page can only report
      it as a browser-settings problem: no setting on the device could have
      granted it. Shells published before counter 20006 are in exactly that
      state; `frontend/ui/scan/scan-page.tsx` names that counter so an older
      shell is told to update instead.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!--
      The camera is a Scanner feature, not a requirement: someone with no camera
      still gets uploads, so declaring the permission must not imply the hardware
      (which is what filters an app out of stores and devices otherwise).
    -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <!--
      Installing the shell's own update (ADR-0044) means handing an APK to the
      platform installer, which Android only allows an app that holds this. It is
      not a Play-style updater: the shell distributes its APK directly, and the
      installer still asks the user before anything is installed.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Required from Android 13 to show any notification, including FCM pushes. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
