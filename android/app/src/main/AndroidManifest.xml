<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!--
          The launcher, and the app's navigation root (#647, ADR-0105).

          The splash theme, the first frame and the route grammar are this
          activity's; the document is a destination it opens rather than the app
          itself. The deep-link filters live here for the same reason: a link
          names a route, and the route is what decides whether the shell draws a
          screen or hands the route to the document.
        -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".shell.ShellActivity"
            android:label="@string/app_name"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Deep links. A link to our own origin should open the app rather than
              a browser tab: autoVerify makes Android confirm us against
              https://royaraqamia.com/.well-known/assetlinks.json, which lists
              both the release and the debug signing certificate.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="royaraqamia.com" />
            </intent-filter>

            <!--
              The OAuth return trip. Google refuses its consent screen in an
              embedded browser, so sign-in leaves for the system browser and comes
              back on this scheme; the shell maps it onto the https callback route
              (`shell/DeepLink.kt`). Keep in sync with NATIVE_OAUTH_CALLBACK_URL in
              shared/contracts/auth.ts and the Supabase redirect allowlist.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="royar" android:host="auth" />
            </intent-filter>

        </activity>

        <!--
          The document: every surface the shell does not draw yet, opened at the
          route it was handed (#647). It is no longer the launcher, so it has no
          splash theme of its own — a second splash on the hand-over would be a
          frame of the platform between the app's own frame and the surface — and
          it is `singleTop`, so a second hand-over reuses the instance instead of
          stacking another copy of the same screen behind the same frame.
        -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBar"
            android:launchMode="singleTop"
            android:exported="true" />

        <!--
          FCM needs a channel on Android 8+; this is the one the system falls
          back to when a push does not name its own.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="default" />

        <!--
          The shell's FCM receiver (ADR-0059, ADR-0060). Firebase delivers
          MESSAGING_EVENT to exactly one service, so the plugin's is removed
          rather than left beside ours, and `SyncMessagingService` delegates the
          plugin's own two jobs (a message's data for the page, a rotated token)
          back to it. Leaving both declared would be a coin toss over which one
          receives a push — including the visible ones the notification bell
          depends on.
        -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />
        <service
            android:name=".SyncMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!--
          The recitation's player (ADR-0086). A media3 MediaSessionService: the
          system notification, the lock screen and the media keys are drawn from
          the session it owns, and `stopWithTask=false` is what keeps the stream
          alive when the app is swiped away. The intent filter is the action the
          platform and external controllers look for.
        -->
        <service
            android:name=".QuranPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      The native recitation (ADR-0086): a foreground media service keeps the
      player alive with the screen off, the wake lock keeps the CPU and network
      awake while it plays, and the network state is what decides whether a keep
      is allowed to spend data.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      The Scanner (ADR-0035) calls `getUserMedia`, and the WebView asks the app
      for the camera — Capacitor turns `VIDEO_CAPTURE` into this permission and
      launches Android's own request (`BridgeWebChromeClient.onPermissionRequest`).
      Undeclared, the request is refused before any dialog is drawn, Chrome
      rejects `getUserMedia` with `NotAllowedError`, and the page can only report
      it as a browser-settings problem: no setting on the device could have
      granted it. Shells published before counter 20006 are in exactly that
      state; `frontend/ui/scan/scan-page.tsx` names that counter so an older
      shell is told to update instead.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!--
      The camera is a Scanner feature, not a requirement: someone with no camera
      still gets uploads, so declaring the permission must not imply the hardware
      (which is what filters an app out of stores and devices otherwise).
    -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <!--
      Installing the shell's own update (ADR-0044) means handing an APK to the
      platform installer, which Android only allows an app that holds this. It is
      not a Play-style updater: the shell distributes its APK directly, and the
      installer still asks the user before anything is installed.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Required from Android 13 to show any notification, including FCM pushes. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      The battery-optimization exemption prompt (ADR-0059's amendment, #381). Doze
      defers both halves of the background path — the FCM wake and the CONNECTED
      WorkManager drain — so delivery can wait for an open the user did not plan.
      Holding this permission is what makes the platform's one-tap dialog
      (ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS) reachable, which the shell
      asks for from a notification the moment a drain ends with work still owed
      or a wake arrives in the background. Play's policy restricts that dialog to
      specific app categories for apps it distributes; this shell is installed
      directly (ADR-0036), and the notification's copy states the reason, which
      is the "with the reason stated" the ADR asked for.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
</manifest>
