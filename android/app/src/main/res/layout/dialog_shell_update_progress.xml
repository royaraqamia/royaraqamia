<?xml version="1.0" encoding="utf-8"?>
<!--
  The download in progress (ADR-0054).

  It is not cancelable by back or by tapping outside — an interrupted install is
  the one state worse than a slow one — so «إلغاء» is the only way out, and it is
  a deliberate gesture rather than an accident of the system bar.

  What the card says, and why each part is here:

  - The title is the *state* rather than the product's name, because by this
    point the user has already agreed to it; the same headline as the offer would
    be a sentence they have read. It is centred like the offer's, so the card does
    not change alignment as it becomes the download.
  - The numbers live under the bar rather than beside the title. Sharing the
    title's line cost the headline a quarter of its width and wrapped it on a
    narrow phone — measured on a 320dp AVD, «جاري تنزيل التَّحديث…» came out as two
    lines with the percentage wedged beside them. The bar is what the numbers
    describe, so they belong to it.
  - The percentage is at the start of that row, where the reading begins, and the
    size is at the end: «22%‎ … 6.6 من 30 م.ب». The size is the manifest's own
    number, so it is also the honest answer to "why is this taking so long" on a
    slow connection.
  - The bar is 6dp with the brand gradient in it, and it fills from the right
    because the layout is RTL. There is no spinner anywhere in this dialog: an
    indeterminate one would hide exactly the information the card exists to carry.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/shell_update_progress_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ibm_plex_sans_arabic_bold"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2"
        android:text="@string/shell_update_downloading"
        android:textColor="@color/roy_foreground"
        android:textSize="20sp" />

    <ProgressBar
        android:id="@+id/shell_update_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="18dp"
        android:max="100"
        android:progressDrawable="@drawable/roy_progress" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/shell_update_progress_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ibm_plex_sans_arabic_bold"
            android:textColor="@color/roy_primary"
            android:textSize="15sp"
            tools:text="23%" />

        <TextView
            android:id="@+id/shell_update_progress_size"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="@font/ibm_plex_sans_arabic_regular"
            android:gravity="end"
            android:textColor="@color/roy_subtle"
            android:textSize="13sp"
            tools:text="6.6 من 30 م.ب" />

    </LinearLayout>

    <Button
        android:id="@+id/shell_update_cancel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/roy_button_secondary"
        android:fontFamily="@font/ibm_plex_sans_arabic_regular"
        android:gravity="center"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:stateListAnimator="@null"
        android:text="@string/shell_update_cancel"
        android:textAllCaps="false"
        android:textColor="@color/roy_muted_foreground"
        android:textSize="15sp" />

</LinearLayout>
