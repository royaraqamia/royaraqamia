<?xml version="1.0" encoding="utf-8"?>
<!--
  Generated by `npm run tokens:generate` from `shared/tokens/tokens.json`.
  Do not edit: change the token and regenerate.

  The shell's dialogs, its launch skeleton and its update bar are drawn by
  Android rather than by the WebView, so they cannot read a CSS custom
  property (ADR-0054). A colour with a `token` is one of the site's own; one
  with only a `hex` is a colour only the shell needs. `npm run check:tokens`
  fails a stale copy, which is what keeps the two clients agreeing.
-->
<resources>
    <color name="roy_background">#FF121216</color>
    <!--
      The dialog card's edge. The site draws its dialogs with border-border/60, so
      this is the border token at 60% over the card, kept translucent so it stays
      right if the surface behind it ever changes.
    -->
    <color name="roy_border_hairline">#9935353B</color>
    <color name="roy_border">#FF35353B</color>
    <!--
      The unfilled half of the download bar: the site's secondary.
    -->
    <color name="roy_track">#FF26262B</color>
    <color name="roy_foreground">#FFF5F5F5</color>
    <color name="roy_muted_foreground">#FFADADAD</color>
    <!--
      One step quieter than muted-foreground, for the update dialog's meta line:
      the versions and the download size are facts about the update, not the
      sentence asking the question. No site surface needed a third level, so it is
      the shell's own value rather than a second name for one of the palette's.
    -->
    <color name="roy_subtle">#FF8A8A8A</color>
    <!--
      The one accent. The site's ring is the same value, so focus and accent are
      one colour by design.
    -->
    <color name="roy_primary">#FF8F70E6</color>
    <color name="roy_primary_foreground">#FFFFFFFF</color>
    <!--
      The Hero CTA's gradient, carried from app/global.css, which spells it out as
      linear-gradient(120deg, #8b5cf6 0%, #7c3aed 50%, #6366f1 100%) in three
      places. Not a token: the shell only needs the three stops, and Android can
      turn a gradient in 45-degree steps.
    -->
    <color name="roy_gradient_start">#FF8B5CF6</color>
    <color name="roy_gradient_mid">#FF7C3AED</color>
    <color name="roy_gradient_end">#FF6366F1</color>
    <!--
      The CTA's own glow, the site's
      shadow-[0_10px_30px_-10px_rgba(147,51,234,0.5)]. Android casts window
      elevation shadows in the ambient and spot colours from API 28; below that
      this is ignored and the shadow is the platform's.
    -->
    <color name="roy_primary_glow">#809333EA</color>
    <!--
      Touch feedback, drawn as a ripple over each button: white at 20% on the
      primary fill.
    -->
    <color name="roy_ripple_on_primary">#33FFFFFF</color>
    <!--
      The same ripple on a surface rather than a fill: white at 12%.
    -->
    <color name="roy_ripple_on_surface">#1FFFFFFF</color>
    <!--
      The scrim the site's own dialogs use: bg-black/70.
    -->
    <color name="roy_scrim">#B3000000</color>
    <!--
      The surface the splash, the WebView and the skeleton all paint, so the cold
      start has one colour from the launcher to the document. Deliberately not the
      site's background: the page is #121216, while the window behind it
      (capacitor.config.ts's backgroundColor and the status bar) is #0f172a, and
      the skeleton follows the window, which is what the splash hands over to. The
      launch theme restates the value in styles.xml because the icon test pins it
      there.
    -->
    <color name="roy_launch_background">#FF0F172A</color>
    <!--
      The card the launch skeleton draws, one step lighter than the window behind
      it.
    -->
    <color name="roy_skeleton_card">#FF1B2334</color>
    <!--
      The bars, dots and pills inside those cards, one step lighter again, all in
      the window's slate family.
    -->
    <color name="roy_skeleton_shape">#FF2C3A55</color>
    <color name="roy_skeleton_hairline">#FF22304A</color>
</resources>
