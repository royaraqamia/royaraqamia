<?xml version='1.0' encoding='utf-8'?>
<resources>
    <string name="app_name">رؤيَة رقَميَّة</string>
    <string name="title_activity_main">رؤيَة رقَميَّة</string>
    <string name="package_name">com.royaraqamia.app</string>
    <string name="custom_url_scheme">com.royaraqamia.app</string>

    <!--
      The shell's own update prompt (ADR-0043, ADR-0054). Native, because the
      page cannot be relied on to carry it: the Capacitor bridge is missing on
      the WebViews this app supports.

      The copy follows the site's own voice — a plain statement of what is
      available and what the button does, with no "we recommend", no countdown
      and no exclamation. «تنزيل وتثبيت» names both halves of what the button
      starts, because the platform's own confirmation is still to come and a
      button that only promises a download reads as a betrayal when an installer
      appears instead.

      The tashkeel is deliberate and only where it disambiguates: the shadda on
      «التَّحديث», «التَّنزيل» and «الاتِّصال», and the fatha on «ثمَّ». It is not a
      general vowelling of the strings — «يتوفَّر» and «تعذَّر» already carried
      theirs — so this stays a reading aid rather than decoration.
    -->
    <string name="shell_update_title">تحديث التَّطبيق</string>
    <string name="shell_update_message">يتوفَّر إصدار جديد من التَّطبيق. أصبح تحديث التَّطبيق يحمل إصلاحات الواجهة، ولم يعد نشر الموقع يصل إلى التَّطبيق. تنزيله الآن؟</string>
    <string name="shell_update_install">تنزيل وتثبيت</string>
    <string name="shell_update_later">لاحقًا</string>
    <string name="shell_update_required_title">تحديث مطلوب</string>
    <string name="shell_update_required_message">هذا الإصدار من التَّطبيق لم يعد مدعومًا. حدِّث التَّطبيق للمتابعة.</string>
    <!-- «تحديث من 1.0.2 إلى 1.0.4» — the version jump in words rather than as
         `1.0.2 → 1.0.4`: inside an RTL paragraph the arrow's direction reverses,
         so the same characters read as a downgrade on half of the devices. -->
    <string name="shell_update_meta">تحديث من %1$s إلى %2$s</string>
    <string name="shell_update_size">%1$s م.ب</string>
    <string name="shell_update_failed_title">تعذَّر تنزيل التَّحديث</string>
    <string name="shell_update_retry">إعادة المحاولة</string>

    <!--
      The install itself (ADR-0044, ADR-0054). The APK is downloaded, checked
      against the size and hash the manifest published, and only then handed to
      the system installer — which is what asks the last question.
    -->
    <string name="shell_update_downloading">جاري تنزيل التَّحديث…</string>
    <!-- `%%` is a literal percent sign for `String.format`, so this renders as
         «42%». Western digits, like every other number the app shows; the
         formatter in `ShellUpdatePrompt.formatPercent` pins `Locale.ROOT` so an
         Arabic-locale phone cannot turn it into Arabic-Indic digits. -->
    <string name="shell_update_percent">%1$d%%</string>
    <string name="shell_update_progress_size">%1$s من %2$s م.ب</string>
    <string name="shell_update_cancel">إلغاء</string>
    <!-- Said only after «إلغاء» has been tapped: the download stops at the next
         read rather than instantly, and a button that appears to do nothing for
         a second is worth a word. -->
    <string name="shell_update_cancelling">جاري الإلغاء…</string>
    <string name="shell_update_allow_installs">اسمح لرؤيَة رقَميَّة بتثبيت التَّطبيقات من هذا المصدر، ثمَّ عُد إلى التَّطبيق.</string>
    <string name="shell_update_download_failed">لم يكتمل التَّنزيل. تحقَّق من الاتِّصال ثمَّ أعد المحاولة.</string>
    <string name="shell_update_verify_failed">الملف الذي نزَّلناه لا يطابق الإصدار المنشور، ولم يُثبَّت شيء.</string>
    <string name="shell_update_no_installer">تعذَّر فتح مُثبِّت التَّطبيقات على هذا الجهاز، ولم يُثبَّت شيء.</string>

    <!--
      The battery-optimization exemption (ADR-0059's amendment, #381). A drain
      that ended with work still owed, or a wake received with the app in the
      background, asks here once, and the notification's tap opens the platform's
      one-tap dialog (ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS). The copy
      therefore carries the whole reason on its own: what was recorded, what
      defers it, and what the tap starts — the dialog it opens cannot be relied
      on to be read first.

      The voice is ADR-0054's: a plain statement of a fact and of what the press
      does, no exclamation and no promises about battery life the platform does
      not make. Tashkeel only where it disambiguates, as with the update strings:
      the shadda on the أجّل root of «تؤجِّل» and on «رصَّدتَه», and the fatha
      that says the «تَه» is an object, not a conjugation slip.
    -->
    <string name="battery_channel_name">التَّسليم في الخلفية</string>
    <string name="battery_channel_description">حالة ما رصَّدته وهو مغلق: متى وصل، وما ينتظر.</string>
    <string name="battery_prompt_title">تأخُّر وصول ما رصَّدته</string>
    <string name="battery_prompt_message">تؤجِّل تحسينات البَّطارية وصول ما رصَّدتَه وهو مغلق. اضغط لطلب استثناء لهذا التَّطبيق، فيصل في وقته.</string>

    <!--
      The recitation's own notification channel (ADR-0086). It is a media
      session, so the platform's Play/Pause, Stop, previous/next and seek bar
      are drawn on it; the copy only names what is playing.
    -->
    <string name="quran_channel_name">تلاوة القرآن</string>
    <string name="quran_channel_description">مُشغِّل التِّلاوة وأدواته، يعمل والتِّطبيق في الخلفية.</string>
</resources>
