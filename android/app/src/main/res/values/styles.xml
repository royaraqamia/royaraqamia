<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!--
      The launch theme is the whole splash: one theme, read by the platform on
      Android 12+ and by `androidx.core:core-splashscreen` below it (which
      `MainActivity` installs), so every Android version draws the same splash from
      the same three items and no splash-specific drawable or bitmap exists.

      `windowSplashScreenAnimatedIcon` is the launcher icon, so the splash is the
      app's own icon rather than a second copy of the artwork kept in step by hand.
      The platform sizes and masks it itself — larger than the launcher draws it,
      which is the platform's geometry rather than a number we chose; the measured
      numbers are in `docs/mobile/android-shell.md`. The background is the shell's
      own `#0f172a`, which is what the WebView paints, so the splash hands over to
      the loading page without a colour change. `postSplashScreenTheme` is the theme
      the activity switches to once the splash is dismissed; the platform dismisses
      it when the app draws its first frame, so no duration is declared here.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0f172a</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
