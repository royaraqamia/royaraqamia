<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Base application theme.

      Dark, not `DayNight` (ADR-0054). The shell renders a site that is dark
      unconditionally — `app/global.css` declares its tokens once in `:root`
      rather than under a `.dark` class, and `next` never emits a light one — and
      the window behind it is #0f172a (`capacitor.config.ts`). A DayNight parent
      therefore has exactly one visible effect: on a phone in light mode every
      surface the *shell* owns, rather than the site, renders light and lands on
      top of a dark product. That is what the platform-styled dialog did before
      this, and it was the loudest thing wrong with it.

      `colorPrimary`/`colorPrimaryDark`/`colorAccent` used to point at
      `@color/colorPrimary` and friends, which this repository has never defined
      — they resolved out of a dependency that happens to ship those names, which
      is why nothing failed loudly. They now name the brand.
    -->
    <style name="AppTheme" parent="Theme.AppCompat">
        <item name="colorPrimary">@color/roy_primary</item>
        <item name="colorPrimaryDark">@color/roy_background</item>
        <item name="colorAccent">@color/roy_primary</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!--
      The shell's own dialogs (ADR-0054): the update offer, the download in
      progress, and a failed download.

      The parent is a bare `Theme.AppCompat.Dialog` rather than an alert style,
      because the dialogs are not the platform's any more — the card, the
      buttons and the bar are all drawables in this app, and every piece of
      chrome the parent would draw (a title, a divider, a button panel) is
      removed here and laid out in the layouts instead.

      The width is set from code rather than by `windowMinWidthMajor`/`Minor`,
      which are *fractions of the screen*: on a tablet the platform default of
      65% is a card most of a metre wide. The layout wants a fixed 24dp gutter
      and a readable maximum, so `ShellUpdatePrompt` sets the window's layout to
      the smaller of the screen less that gutter and 400dp. The two minimums
      below are lowered anyway, to 40%, so that the platform's measurement can
      never ask for more than the code did.
    -->
    <style name="Theme.Royaraqamia.Dialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@drawable/roy_dialog_background</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowMinWidthMajor">40%</item>
        <item name="android:windowMinWidthMinor">40%</item>
        <item name="android:windowAnimationStyle">@style/RoyaraqamiaDialogAnimation</item>
        <!-- `bg-black/70` — the scrim the site's own dialogs use. -->
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.70</item>
        <!-- Nothing here is a themed widget, but the accent is set so that
             anything added later agrees with the brand by default. -->
        <item name="colorPrimary">@color/roy_primary</item>
        <item name="colorAccent">@color/roy_primary</item>
        <item name="colorControlHighlight">@color/roy_ripple_on_surface</item>
    </style>

    <!--
      The site's dialog motion, in the platform's terms: `zoom-in-95` and
      `fade-in-0` over 200ms with a fast-out-slow-in curve. Not a decoration —
      a dialog that appears without a frame of movement reads as a rendering
      glitch on a phone that animates everything else.
    -->
    <style name="RoyaraqamiaDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/roy_dialog_in</item>
        <item name="android:windowExitAnimation">@anim/roy_dialog_out</item>
    </style>

    <!--
      The launch theme is the whole splash: one theme, read by the platform on
      Android 12+ and by `androidx.core:core-splashscreen` below it (which
      `MainActivity` installs), so every Android version draws the same splash from
      the same three items and no splash-specific drawable or bitmap exists.

      `windowSplashScreenAnimatedIcon` is `@drawable/splash_icon` — generated from
      the same artwork as the launcher icon, with its disc at
      `TARGET_DISC_RATIO / LAUNCHER_MAGNIFICATION` of the canvas. Both splash
      implementations mask the icon down to a circle two thirds of the area they
      draw it in, which is exactly the launcher's own magnification, so the disc
      lands on the launcher icon's 64% rather than on the artwork's own share; the
      numbers are in `docs/mobile/android-shell.md`.

      The background is the shell's own `#0f172a`, which is what the WebView paints,
      so the splash hands over to the loading page without a colour change.
      `postSplashScreenTheme` is the theme the activity switches to once the splash
      is dismissed; the platform dismisses it when the app draws its first frame,
      so no duration is declared here.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0f172a</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
