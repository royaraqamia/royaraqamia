<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-path name="my_images" path="." />
    <cache-path name="my_cache_images" path="." />
    <!--
      Where a downloaded shell update waits for the installer (ADR-0044). This is
      `getExternalFilesDir()`, which is app-private; the provider is what lets the
      installer read exactly one file, for as long as the install runs.
    -->
    <external-files-path name="shell_updates" path="updates/" />
</paths>
