<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug only: a shell pointed at a local dev server (`CAPACITOR_SERVER_URL`) reads
  that server's manifests and cover over http, which the release network policy
  refuses. The release manifest keeps cleartext off.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:usesCleartextTraffic="true">

        <!--
          The workbench (#647, #501): a second launcher entry that signs in and
          draws the plan card from `/api/me/usage` in the app's own Compose UI.

          It is declared here and nowhere else, so a release APK has neither the
          activity nor the debug-only `BuildConfig` values it reads. Its own label
          keeps it distinguishable from the real app in the launcher while the two
          sides of the app are still one APK (ADR-0089, phase 0).
        -->
        <activity
            android:name=".debug.WorkbenchActivity"
            android:exported="true"
            android:label="@string/title_activity_workbench"
            android:theme="@style/AppTheme.NoActionBarLaunch">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
          The Outbox drill (#650): the debug-only half of
          `npm run android:outbox-drill`. It is exported because the script starts
          it with adb, has no launcher entry because it is not a screen a person
          opens, and does not exist in a release APK because this manifest is not
          merged into one.
        -->
        <activity
            android:name=".debug.OutboxDrillActivity"
            android:exported="true"
            android:theme="@style/AppTheme.NoActionBarLaunch" />

        <!--
          The crash drill (#667): the debug-only half of `npm run android:crash-drill`.
          It throws on purpose, from a real process, so the reporter can be watched
          end to end - the queue file, the release it names and the delivery after
          the radio returns. Exported because the script starts it with adb, no
          launcher entry because it is not a screen, and absent from a release
          APK because this manifest is not merged into one.
        -->
        <activity
            android:name=".debug.CrashDrillActivity"
            android:exported="true"
            android:theme="@style/AppTheme.NoActionBarLaunch" />

    </application>
</manifest>
