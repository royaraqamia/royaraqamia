{
  "generators": [
    {
      "script": "generate-icons.mjs",
      "owns": [
        "public/icons/*.png",
        "public/favicon.ico",
        "public/favicon-*.png",
        "public/manifest.json",
        "backend/config/generated/asset-version.ts"
      ],
      "check": "npm run check:icons"
    },
    {
      "script": "generate-android-assets.mjs",
      "owns": [
        "android/app/src/main/res/mipmap-*/ic_launcher*.png",
        "android/app/src/main/res/values/ic_launcher_background.xml",
        "android/app/src/main/res/drawable-*/splash_icon.png"
      ],
      "check": "npm run check:android-assets"
    },
    {
      "script": "generate-contracts.mjs",
      "owns": ["android/app/src/main/kotlin/com/royaraqamia/app/contracts/generated/*.kt"],
      "check": "npm run check:contracts"
    },
    {
      "script": "generate-capabilities.mjs",
      "owns": ["docs/assistant/capabilities.md"],
      "check": "npm run check:capabilities"
    },
    {
      "script": "generate-copy.mjs",
      "owns": ["app/**/*-copy.ts", "android/app/src/main/kotlin/**/*Copy.kt"],
      "check": "npm run check:copy"
    },
    {
      "script": "generate-currency.mjs",
      "owns": ["android/app/src/main/kotlin/com/royaraqamia/app/shared/CurrencySymbols.kt"],
      "check": "npm run check:currency"
    },
    {
      "script": "generate-tokens.mjs",
      "owns": [
        "app/tokens.css",
        "android/app/src/main/res/values/colors.xml",
        "android/app/src/main/kotlin/com/royaraqamia/app/theme/*.kt"
      ],
      "check": "npm run check:tokens"
    },
    {
      "script": "generate-quran-fonts.mjs",
      "owns": ["frontend/ui/quran/font.ts"],
      "check": "npm run check:quran-fonts"
    },
    {
      "script": "generate-components.mjs",
      "owns": [
        "app/components.css",
        "android/app/src/main/kotlin/com/royaraqamia/app/theme/Recipes.kt"
      ],
      "check": "npm run check:components"
    },
    {
      "script": "generate-vectors.mjs",
      "owns": ["android/app/src/main/kotlin/com/royaraqamia/app/ui/vectors/LucideVectors.kt"],
      "check": "npm run check:vectors"
    }
  ],
  "buildOnly": [
    {
      "script": "generate-quran-cover.mjs",
      "reason": "One-off artwork for the recitation's media controls, regenerated only when the mark changes; its two PNGs are reviewed in the pull request that changes it."
    },
    {
      "script": "generate-vapid.mjs",
      "reason": "Prints a fresh key pair to the console and writes no files; the keys are environment secrets."
    },
    {
      "script": "generate-sw-config.mjs",
      "reason": "Writes gitignored public/sw-push-config.js from local VAPID env at predev/prebuild; there is no committed output to drift."
    },
    {
      "script": "generate-sw-precache.mjs",
      "reason": "Writes gitignored public/sw-precache.js from the .next build output; check:precache gates the route list from that same build."
    },
    {
      "script": "generate-session-cookie-fixture.mjs",
      "reason": "A test fixture regenerated by hand; shared/fixtures/__tests__/session-cookie.test.ts re-derives it and fails on drift."
    },
    {
      "script": "generate-scan-fixture.mjs",
      "reason": "A test fixture regenerated by hand; its unit tests decode the payload and the matrix together."
    }
  ]
}
