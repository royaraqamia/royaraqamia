  "motion": {
    "notes": "The Scanner has no entrance animation of its own: the camera is a live preview and the result card replaces it as soon as a code is read. What moves is the controls' state, not the page - the start control spins while the camera opens, the upload control spins while a picture decodes, and the two buttons lift and settle on hover and press. The same means the same spinner and the same button states, with reduced motion dropping the lift and keeping the progress rings.",
    "entries": [
      {
        "element": "start",
        "gesture": "press the start-camera control until the permission and the preview answer",
        "moves": "the glyph is replaced by a spinning progress ring and the label becomes the opening sentence",
        "same": "the same spinner, label and in-flight state; reduced motion keeps the ring because it reports progress"
      },
      {
        "element": "upload-button",
        "gesture": "choose a picture and wait for the decoder",
        "moves": "the glyph is replaced by a spinning progress ring and the label becomes the reading sentence",
        "same": "the same spinner, label and in-flight state; reduced motion keeps the ring because it reports progress"
      },
      {
        "element": "result-rescan",
        "gesture": "hover over or press a control in the result card",
        "moves": "the button lifts 2px on hover and settles 2% smaller on press",
        "same": "the same 2px lift, 2% press scale and focus ring; reduced motion keeps the colour change only"
      }
    ]
  }
