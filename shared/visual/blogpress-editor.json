{
  "surface": "blogpress-editor",
  "route": "/blogpress/editor/[id]",
  "notes": "The editor (#954): the title, the save state, the body field and the save control. `origin` is the title because the page wears the site's frame and the app wears its own, and the design this slice owns is the gap from the title down to the save control. Two states: `at-rest` is the draft the device holds with every write delivered, and `draft` is the same screen after an edit the server has not accepted yet. The slug and SEO fields are a settings panel on both clients and are not part of this capture; the fields the editor paints from the store are.",
  "states": [
    {
      "name": "at-rest",
      "origin": "title",
      "capture": "content",
      "elements": [
        {
          "name": "title",
          "web": {
            "selector": "[data-visual='blogpress-editor-title']"
          },
          "app": {
            "tag": "blogpress-editor-title"
          },
          "properties": ["top", "width", "height", "fontSize", "fontWeight"]
        },
        {
          "name": "status",
          "web": {
            "selector": "[data-visual='blogpress-editor-status']"
          },
          "app": {
            "tag": "blogpress-editor-status"
          },
          "properties": ["top", "height", "fontSize"]
        },
        {
          "name": "content",
          "web": {
            "selector": "[data-visual='blogpress-editor-content']"
          },
          "app": {
            "tag": "blogpress-editor-content"
          },
          "properties": ["top", "width", "height", "radius"]
        },
        {
          "name": "save",
          "web": {
            "selector": "[data-visual='blogpress-editor-save']"
          },
          "app": {
            "tag": "blogpress-editor-save"
          },
          "properties": ["top", "width", "height", "radius", "fontSize"]
        }
      ]
    },
    {
      "name": "draft",
      "origin": "title",
      "capture": "content",
      "elements": [
        {
          "name": "title",
          "web": {
            "selector": "[data-visual='blogpress-editor-title']"
          },
          "app": {
            "tag": "blogpress-editor-title"
          },
          "properties": ["top", "width", "height", "fontSize", "fontWeight"]
        },
        {
          "name": "status",
          "web": {
            "selector": "[data-visual='blogpress-editor-status']"
          },
          "app": {
            "tag": "blogpress-editor-status"
          },
          "properties": ["top", "height", "fontSize"]
        },
        {
          "name": "content",
          "web": {
            "selector": "[data-visual='blogpress-editor-content']"
          },
          "app": {
            "tag": "blogpress-editor-content"
          },
          "properties": ["top", "width", "height", "radius"]
        },
        {
          "name": "save",
          "web": {
            "selector": "[data-visual='blogpress-editor-save']"
          },
          "app": {
            "tag": "blogpress-editor-save"
          },
          "properties": ["top", "width", "height", "radius", "fontSize"]
        }
      ]
    }
  ]
}
