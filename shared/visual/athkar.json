        "element": "first-card",
        "gesture": "hover over or keyboard-focus a dhikr card",
        "moves": "the card fades its border and background",
        "same": "the same 300ms colour transition; the cards do not travel, and reduced motion keeps the colour change"
      },
      {
        "element": "first-count",
        "gesture": "tap or click the counter",
        "moves": "the counter fades to its complete fill once the narration's count is reached",
        "same": "the same colour transition and final count; reduced motion keeps the colour change, and the number never passes the narration's count"
      },
      {
        "gesture": "open the virtue",
