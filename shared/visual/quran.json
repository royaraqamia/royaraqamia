          },
          "properties": ["width", "height", "radius", "fontSize", "paddingLeft", "paddingRight"]
        },
        {
          "name": "page-jump-submit",
          "web": {
            "selector": "[data-visual='quran-page-jump-submit']"
          },
          "app": {
