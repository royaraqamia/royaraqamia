{
  "name": "رؤية رقمية",
  "version": "1.11.0",
  "description": "نبني مواقع وتطبيقات برؤية رياديَّة، تنفع النَّاس وتمكث في الأرض؛ كما نُقدِّم للطُّلاب والخرِّيجين الجدد تدريبًا احترافيًّا متكاملًا لبناء المواقع والتَّطبيقات.",
  "author": "م. أيْهَم العَلي",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=18.x"
  },
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs'),p=require('path');const d=p.join('node_modules','typescript','lib');if(!fs.existsSync(d)){fs.mkdirSync(d,{recursive:true})}const f=p.join(d,'typescript.js');if(!fs.existsSync(f)){fs.writeFileSync(f,\\\"module.exports = require('typescript/unstable/sync');\\\\n\\\")}\"",
    "dev": "node scripts/dev.mjs",
    "predev": "node scripts/generate-sw-config.mjs && node scripts/compute-version.mjs",
    "prebuild": "node scripts/generate-sw-config.mjs && node scripts/generate-icons.mjs && node scripts/compute-version.mjs",
    "build": "tsc --noEmit && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "fonts:subset": "node scripts/subset-fonts.mjs",
    "version:next": "node scripts/release-tools.mjs --next --dry-run",
    "version:replay": "node scripts/release-tools.mjs --replay",
    "check:env-docs": "node scripts/check-env-docs.mjs"
  },
