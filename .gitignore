# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# OpenCode config is per-machine: `.opencode/.gitignore` covers the canonical checkout, and these
# cover worktrees, which do not get that file. The shared-tree guard plugin lives in plugins/.
/.opencode/node_modules
/.opencode/plugins/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# tests
/test-results
/playwright-report
/e2e/screenshots

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# supabase CLI local state (project ref, pooler url, version caches)
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.idea/
*.swp
*.swo

# OS
Desktop.ini
$RECYCLE.BIN/

# auto-generated
public/sw-version.js
public/sw-precache.js
public/sw-push-config.js
public/sw-outbox.js
public/sync-flush.js
# Copied out of node_modules by scripts/sync-zxing-wasm.mjs so it always matches
# the installed zxing-wasm version (ADR-0035).
public/zxing_reader.wasm

# Sentry Config File
.env.sentry-build-plugin

# Capacitor / Android
# The native project is source and is committed; only build output and
# machine-local state are not. The upload keystore lives *outside* the repo
# (see docs/mobile/android-shell.md) and is referenced by keystore.properties.
/keystore.properties
/android/.gradle/
# Kotlin 2.x build session state, written by a Gradle build.
/android/.kotlin/
/android/local.properties
/android/build/
/android/app/build/
/android/app/release/
/android/app/src/main/assets/public/
/android/capacitor-cordova-android-plugins/
# Firebase config for com.royaraqamia.app is *committed*: it holds the project id and the
# Android API key every APK ships inside itself anyway, and a build that lacked it shipped a
# shell whose push plugin crashed the app on tap (ADR-0050). Do not re-ignore it.
*.jks
*.keystore
