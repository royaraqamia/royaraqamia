NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_WHATSAPP_PHONE=

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=

NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

ADMIN_EMAILS=

MCP_TOKEN_ENCRYPTION_KEY=

# A client we registered by hand with a provider that refuses dynamic
# registration (#1229). The id and secret come from that provider's console; the
# endpoints live in `backend/config/mcp-static-clients.ts`. Leaving the id empty
# leaves the provider on the dynamic path.
MCP_STATIC_CLIENT_GITHUB_ID=
MCP_STATIC_CLIENT_GITHUB_SECRET=

# Salt for hashing a visitor's address into the anonymous allowance's subject.
# Server-only; rotating it forgets every visitor's 24-hour window (ADR-0075).
ANONYMOUS_IP_SALT=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

PENDING_LOGIN_SECRET=

PASSWORD_BREACH_CHECK_ENABLED=

E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

# The visual gate's own fixture account (#920). The offline specs write to the
# E2E_TEST_* account, so the gate must not record a baseline from it.
E2E_VISUAL_EMAIL=
E2E_VISUAL_PASSWORD=

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
PUSH_WEBHOOK_TOKEN=
PUSH_ENDPOINT_ALLOWLIST=

CRON_SECRET=

DOWNLOADER_PROVIDER_URL=
DOWNLOADER_PROVIDER_TOKEN=
DOWNLOADER_CALLBACK_SECRET=

# The assistant's OpenAI-compatible provider (chats, ADR-0113). The defaults are
# OpenCode's gateway and `deepseek-v4.1-flash`, so `OPENCODE_API_KEY` alone is
# enough; these three values are the escape hatch when the vendor changes.
AI_CHAT_BASE_URL=
AI_CHAT_MODEL=
AI_CHAT_API_KEY=
