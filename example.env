NEXT_PUBLIC_SITE_URL=
PUBLIC_ORIGIN=
NEXT_PUBLIC_WHATSAPP_PHONE=

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=

NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

ADMIN_EMAILS=

MCP_TOKEN_ENCRYPTION_KEY=

# The coding agent's GitHub App (ADR-0219). The App installs per member and its
# installation tokens are encrypted with MCP_TOKEN_ENCRYPTION_KEY. The PEM may
# carry literal \n escapes; the client folds them into real newlines.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# HMAC key signing the keyboard's short-lived rewrite credential (ADR-0220).
# Server-only; empty falls back to MCP_TOKEN_ENCRYPTION_KEY. With neither set the
# rewrite endpoint refuses to mint or verify, rather than using a known key.
KEYBOARD_REWRITE_SECRET=

# A client we registered by hand with a provider that refuses dynamic
# registration (#1229). The id and secret come from that provider's console; the
# endpoints live in `backend/config/mcp-static-clients.ts`. Leaving the id empty
# leaves the provider on the dynamic path.
MCP_STATIC_CLIENT_GITHUB_ID=
MCP_STATIC_CLIENT_GITHUB_SECRET=
MCP_CATALOG_AGENT_TOKEN=

# Salt for hashing a visitor's address into the anonymous allowance's subject.
# Server-only; rotating it forgets every visitor's 24-hour window (ADR-0075).
ANONYMOUS_IP_SALT=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

PENDING_LOGIN_SECRET=

PASSWORD_BREACH_CHECK_ENABLED=

E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

# The visual gate's own fixture account (#920). The offline specs write to the
# E2E_TEST_* account, so the gate must not record a baseline from it.
E2E_VISUAL_EMAIL=
E2E_VISUAL_PASSWORD=

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
PUSH_WEBHOOK_TOKEN=
PUSH_ENDPOINT_ALLOWLIST=

CRON_SECRET=

DOWNLOADER_PROVIDER_URL=
DOWNLOADER_PROVIDER_TOKEN=
DOWNLOADER_CALLBACK_SECRET=

# The assistant's OpenAI-compatible provider (chats, ADR-0113). The defaults are
# OpenCode's gateway and `deepseek-v4.1-flash`, so `OPENCODE_API_KEY` alone is
# enough; these three values are the escape hatch when the vendor changes.
AI_CHAT_BASE_URL=
AI_CHAT_MODEL=
AI_CHAT_API_KEY=
# The reviewer of a finished draft (ADR-0213): `claude-haiku-5-5` by default,
# or `off` to keep the single-model turn. It scores and asks for one rewrite;
# it never writes member-facing text or calls a tool.
AI_CHAT_JUDGE_MODEL=

# The assistant's web search (ADR-0206): Tavily's LLM-facing search returns
# ranked page excerpts with dates. Empty means no search tool is declared and
# نور answers exactly as before — never a broken turn. The free tier is 1,000
# credits a month and needs no card.
TAVILY_API_KEY=

# The assistant's embeddings (ADR-0185, ADR-0190): a model of its own, never the
# chat model. Empty means the specialist shortlist and recall both rank by
# words, and a turn still answers. `AI_EMBEDDING_BASE_URL` and
# `AI_EMBEDDING_API_KEY` name a second provider when the chat gateway serves no
# embedding model — this deployment's does not — and fall back to the chat pair
# when they are empty. The width must match what the caller stores: memory's
# table and the specialist artifact are both 1024, and a different width for
# either is a new generation and a rebuild.
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSIONS=

# Whether a settled turn is read for facts worth saving (ADR-0182 decision 2,
# #1511, ADR-0197). One provider call per turn and a row on the member's behalf,
# so it is off unless a deployment says `1` after a measurement.
MEMORY_EXTRACTION=
